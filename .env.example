# ChatAnywhere API Key（主对话、grader、联网搜索共用）
# 获取地址: https://chatanywhere.apifox.cn
CHATANYWHERE_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.chatanywhere.tech/v1
LLM_TIMEOUT_SECONDS=120
# 可选：不填则使用 LLM_MODEL；联网搜索使用的模型
WEB_SEARCH_MODEL=gpt-4o-mini
DATABASE_URL=postgresql://erp_agent:erp_agent@localhost:5432/erp_agent
LANGGRAPH_STRICT_MSGPACK=true
WRITE_RECONCILE_INTERVAL_SECONDS=10
WRITE_RECONCILE_MAX_ATTEMPTS=5
# 本地默认接 java_erp（mvn spring-boot:run → :8080）
# Compose 全栈仍可用 mock-erp:8081，见 docker-compose.yml
ERP_BASE_URL=http://localhost:8080
MCP_SERVER_URL=http://localhost:9000
SANDBOX_IMAGE=python:3.11-slim
ARTIFACT_TTL_SECONDS=86400

# ===== 三层记忆（HOT / WARM / COLD，均可不配，走默认值）=====
# 情节记忆在 WARM 层停留天数，超过后只在 COLD 按需检索
MEMORY_WARM_EPISODE_DAYS=7
# 情节记忆保留天数，过期后被遗忘（硬删除）
MEMORY_EPISODE_TTL_DAYS=90
# COLD 层单次检索返回条数
MEMORY_RETRIEVAL_K=5
# 每位用户最多保留的情节条数
MEMORY_MAX_EPISODES=200
# 是否向 Agent 暴露 read_memory / remember 工具
MEMORY_TOOLS_ENABLED=true
# 是否启用 LLM 抽取偏好（默认关闭，走零成本确定性规则）
MEMORY_LLM_EXTRACTION=false

# 可选 OpenAI-compatible embedding 服务；未配置时使用稳定的 256 维本地降级向量。
KNOWLEDGE_EMBEDDING_URL=
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
