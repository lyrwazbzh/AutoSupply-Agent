# ChatAnywhere API Key（主对话、grader、联网搜索共用）
# 获取地址: https://chatanywhere.apifox.cn
CHATANYWHERE_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.chatanywhere.tech/v1
LLM_TIMEOUT_SECONDS=120
# Agent 不再根据模型名称猜上下文窗口。更换 LLM_MODEL 时同步填写真实输入上限。
LLM_CONTEXT_WINDOW_TOKENS=128000
# 达到 75% 时压缩旧消息，压缩后保留最近 15% 的原始上下文。
CONTEXT_COMPACTION_TRIGGER_RATIO=0.75
CONTEXT_COMPACTION_KEEP_RATIO=0.15
CONTEXT_SUMMARY_SCHEMA_VERSION=procurement-v1
# 可选：不填则使用 LLM_MODEL；联网搜索使用的模型
WEB_SEARCH_MODEL=gpt-4o-mini
DATABASE_URL=postgresql://erp_agent:replace-with-local-password@localhost:5432/erp_agent
LANGGRAPH_STRICT_MSGPACK=true
WRITE_RECONCILE_INTERVAL_SECONDS=10
WRITE_RECONCILE_MAX_ATTEMPTS=5
# 本地默认接 java_erp（mvn spring-boot:run → :8080）
# Compose 全栈使用 java-erp:8080；Mock 仅保留在 deploy/ci/compose.mock-erp.yml 做契约测试。
ERP_BASE_URL=http://localhost:8080
MCP_SERVER_URL=http://localhost:9000
# 钉钉回调默认 fail-closed；本机离线开发可显式设 DINGTALK_SKIP_SIGN=1。
DINGTALK_CALLBACK_SECRET=
DINGTALK_SKIP_SIGN=0
ERP_DB_HOST=localhost
ERP_DB_PORT=3306
MYSQL_DATABASE=motorparts_db
MYSQL_USER=motorparts
MYSQL_PASSWORD=
MOTORPARTS_SEED_ENABLED=true
ERP_REPLENISHMENT_ENABLED=true
ERP_REPLENISHMENT_CRON="0 0 2 * * *"
ERP_REPLENISHMENT_ZONE=Asia/Shanghai
ERP_REPLENISHMENT_TARGET_MULTIPLIER=2
SANDBOX_IMAGE=python:3.11-slim
ARTIFACT_TTL_SECONDS=86400

# ===== 三层记忆（HOT / WARM / COLD，均可不配，走默认值）=====
# 情节记忆在 WARM 层停留天数，超过后只在 COLD 按需检索
MEMORY_WARM_EPISODE_DAYS=7
# 情节记忆保留天数，过期后被遗忘（硬删除）
MEMORY_EPISODE_TTL_DAYS=90
# COLD 层单次检索返回条数
MEMORY_RETRIEVAL_K=5
# 每位用户最多保留的情节条数
MEMORY_MAX_EPISODES=200
# 是否向 Agent 暴露 read_memory / remember 工具
MEMORY_TOOLS_ENABLED=true
# 是否启用 LLM 抽取偏好（默认关闭，走零成本确定性规则）
MEMORY_LLM_EXTRACTION=false

# 可选 OpenAI-compatible embedding 服务；未配置时使用稳定的 256 维本地降级向量。
KNOWLEDGE_EMBEDDING_URL=
KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
# AgentSession 只缓存能力相同的 Agent 图；JWT 按请求注入，不进入缓存。
AGENT_SESSION_TTL_SECONDS=1800
AGENT_SESSION_MAX_ENTRIES=128
AGENT_RUN_LEASE_TTL_SECONDS=180
