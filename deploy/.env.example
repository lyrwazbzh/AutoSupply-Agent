# ERP-AGENT 容器部署配置
#
#   cp deploy/.env.example deploy/.env
#   编辑 deploy/.env 后 docker compose up -d
#
# 这个文件由数据层、Java ERP 和 Python 服务通过 env_file 读取，是唯一的
# 运行时配置源。项目根的 .env 是本地开发配置，容器部署不读它。

# ============================================================
# PostgreSQL + pgvector
# ============================================================
# 下面三个变量由 PostgreSQL 镜像在**首次初始化数据卷**时消费。
# 改完必须 docker compose down -v 让数据卷重建，否则不生效。
POSTGRES_USER=erp_agent
POSTGRES_PASSWORD=replace-with-generated-postgres-password
POSTGRES_DB=erp_agent
# 容器内 backend 会由 compose 固定覆盖为 postgres 服务地址；本变量供其他部署方式使用。
DATABASE_URL=postgresql://erp_agent:replace-with-generated-postgres-password@postgres:5432/erp_agent
LANGGRAPH_STRICT_MSGPACK=true
WRITE_RECONCILE_INTERVAL_SECONDS=10
WRITE_RECONCILE_MAX_ATTEMPTS=5

# ============================================================
# Java ERP + MySQL
# ============================================================
# 从密钥管理器生成两个不同的强口令（例如 `openssl rand -hex 24`）。
# 这里只保留占位值，真实口令只写入不入库的 deploy/.env。
# MySQL 只在 data 内网监听，不发布宿主端口。
MYSQL_DATABASE=motorparts_db
MYSQL_USER=motorparts
MYSQL_PASSWORD=replace-with-generated-app-password
MYSQL_ROOT_PASSWORD=replace-with-generated-root-password
ERP_DB_HOST=mysql
ERP_DB_PORT=3306

# Redis 只供 Java ERP 使用，不发布宿主机端口。请生成独立强口令。
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-generated-redis-password
REDIS_DATABASE=0
REDIS_TIMEOUT=3s

# 确定性补货巡检；单实例 Compose 使用 Spring @Scheduled，不依赖 Redis 锁。
ERP_REPLENISHMENT_ENABLED=true
ERP_REPLENISHMENT_CRON="0 0 2 * * *"
ERP_REPLENISHMENT_ZONE=Asia/Shanghai
ERP_REPLENISHMENT_TARGET_MULTIPLIER=2

# ERP 统一身份：Java ERP 只使用 RS256 签发令牌，私钥仅挂给 java-erp，
# 公钥只读挂给 backend/mcp。先运行：bash deploy/generate-jwt-keys.sh
ERP_SECURITY_ENABLED=true
ERP_JWT_PRIVATE_KEY_PATH=/run/secrets/erp-jwt-private.pem
ERP_JWT_PUBLIC_KEY_PATH=/run/secrets/erp-jwt-public.pem
ERP_JWT_REQUIRE_CONFIGURED_KEY=true
ERP_JWT_ISSUER=java-erp
ERP_JWT_AUDIENCE=erp-api,assistant-api,mcp
ERP_JWT_ACCESS_TTL_SECONDS=900
ERP_REFRESH_TTL_SECONDS=604800
# 生产 HTTPS 必须设为 true；本地纯 HTTP/CI 可保持 false。
ERP_COOKIE_SECURE=false
# 首次部署可临时填写；创建成功后应清空并重建 java-erp 容器。
ERP_BOOTSTRAP_ADMIN_USERNAME=
ERP_BOOTSTRAP_ADMIN_PASSWORD=

# Python backend 与 MCP 只需要公钥。backend 接受 audience=assistant-api，
# MCP 接受 audience=mcp；同一个访问令牌可包含 ERP 配置的多个 audience。
AUTH_MODE=jwt
JWT_PUBLIC_KEY_PATH=/run/secrets/erp-jwt-public.pem
JWT_ISSUER=java-erp
JWT_AUDIENCE=assistant-api
JWT_ACTIVE_CHECK_ENABLED=true
MCP_AUTH_ENABLED=true
MCP_JWT_AUDIENCE=mcp

# 钉钉开放平台回调必须验签。生产配置回调密钥，并保持跳过开关为 0。
# 只有本机开发且不接收真实外部流量时，才可显式设 DINGTALK_SKIP_SIGN=1。
DINGTALK_CALLBACK_SECRET=
DINGTALK_SKIP_SIGN=0

# ============================================================
# LLM（必填）
# ============================================================
# ChatAnywhere：OpenAI 兼容网关，支持 gpt-4o / claude / deepseek 等模型
# 获取地址: https://chatanywhere.apifox.cn
CHATANYWHERE_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.chatanywhere.tech/v1
# 必须与网关实际模型一致；默认 gpt-4o-mini 为 128K 输入窗口。
LLM_CONTEXT_WINDOW_TOKENS=128000
CONTEXT_COMPACTION_TRIGGER_RATIO=0.75
CONTEXT_COMPACTION_KEEP_RATIO=0.15
CONTEXT_SUMMARY_SCHEMA_VERSION=procurement-v1
WEB_SEARCH_MODEL=gpt-4o-mini

# ============================================================
# 对外地址（必填）
# ============================================================
# 生成给用户看的下载链接用的根地址，必须是浏览器能打开的地址。
# 不要写容器内的 http://backend:8000 —— 用户点开必然失败。
# 例如 http://192.168.1.50 或 https://erp.example.com
PUBLIC_BASE_URL=http://localhost
# 临时生成文件保留时间，默认 24 小时。
ARTIFACT_TTL_SECONDS=86400

# 逗号分隔。走 nginx 后前后端同源，本项实际不再生效，只服务直连后端的本地开发。
CORS_ALLOW_ORIGINS=http://localhost

# ============================================================
# HTTPS / TLS（容器部署强烈建议开启）
# ============================================================
# 登录令牌与刷新 Cookie 在 HTTP 上传输同样不安全，生产环境必须开 TLS。
#
# 用法：
#   1) 在 deploy/nginx.env 里设 TLS_ENABLED=1
#   2) 把证书放在 deploy/nginx/tls/cert.pem 和 key.pem
#      （bootstrap.sh 会自动生成：有域名走 certbot，否则 openssl 自签）
#   3) docker compose up -d nginx
#
# TLS_ENABLED 留空 = 纯 HTTP（开发 / CI 默认，与加 TLS 前完全一致）。
# TLS_ENABLED=1   = 启用：80 → 443 跳转，443 跑 ssl + 同一套 location。
#
# HTTPS_PORT 只在 compose 端口映射里用，nginx 内部固定监听 443。
HTTPS_PORT=443

# ============================================================
# 镜像仓库（可选，生产环境强烈建议配置）
# ============================================================
# 配置后 build.sh 会 --push 到 registry，deploy.sh 会先 docker pull。
# 留空 = 完全本地模式（构建机 == 运行机，机器丢 = 镜像全丢 + 回滚归零）。
#
# 例：
#   REGISTRY_URL=registry.cn-hangzhou.aliyuncs.com
#   REGISTRY_USER=erp@xxx
#   REGISTRY_PASSWORD=xxx
# 凭据走 ~/.docker/config.json（bootstrap.sh 用 docker login 写入），
# 不经 env_file。
REGISTRY_URL=
REGISTRY_USER=
REGISTRY_PASSWORD=

# ============================================================
# 可观测性（可选）
# ============================================================
# Prometheus 数据保留时间。留空 = 默认 15 天。
PROMETHEUS_RETENTION=15d
# Grafana 管理员密码。留空 = 随机生成并打印一次（仅 bootstrap 时）。
GRAFANA_PASSWORD=
# Grafana 对外端口。留空 = 默认 13000（避开常用端口）。
GRAFANA_PORT=13000

# ============================================================
# 沙箱
# ============================================================
# 沙箱镜像 tag。容器化部署下由 sandbox-image-loader 用 deploy/sandbox/Dockerfile
# 在 dind 里现构建（预装 matplotlib/pandas/numpy 与中文字体，chart_generator
# 不再需要运行时冷装）；backend 与 loader 读同一个值。
# 本地开发（backend 直连宿主机 daemon、不经 compose）需要先手动构建：
#   docker build -f deploy/sandbox/Dockerfile -t erp-sandbox:3.11 deploy/sandbox
# 不想预装就配回 python:3.11-slim，依赖退回运行时按需安装（注意：那样会在
# dind 里以这个名字盖掉官方镜像的内容，建议换个自己的 tag）。
SANDBOX_IMAGE=erp-sandbox:3.11
SANDBOX_WARM_POOL_SIZE=1
SANDBOX_IDLE_TIMEOUT_MINUTES=30
# dind 冷启动时容器创建里可能夹着镜像 pull，SDK 默认 60s 不够。
# 这个值同时是沙箱内 timeout(1) 的上限：必须大于 sandbox_setup 里最长的单命令
# 超时 900s，否则长命令会先撞上客户端 socket 超时、丢掉"[超时]"这个原因
# （见 custom_opensandbox.execute 的 clamp 与 config.py 的注释）。
DOCKER_TIMEOUT_SECONDS=1200

# 沙箱内的代码按这个地址访问 MCP Server。两个都留空 = 沙箱里没有 MCP 能力。
#
# HOST_IP 必须是 mcp 在 mcp-sandbox 网络上的**静态 IP**（见
# docker-compose.yml 里 mcp 服务的 ipv4_address），两边改一处必须改两处。
# 沙箱容器跑在 dind 自己的 bridge 里，解析不了 compose 的服务名，只能靠
# backend 把这个 IP 写进容器的 /etc/hosts。
#
# 不对公网暴露 MCP 的话，这项可以整段注释掉。
# 阶段 2 默认关闭：不能把用户访问令牌注入会执行模型生成代码、且可出网的沙箱。
# Agent 自身仍通过带 Bearer 的 MCP 客户端访问 ERP；沙箱若要恢复 MCP，需要先实现
# 独立的短期、不可外用 capability proxy，不能直接复用登录令牌。
SANDBOX_MCP_URL=
SANDBOX_MCP_HOST_IP=

# ============================================================
# 三层记忆（均可不配，走默认值）
# ============================================================
MEMORY_WARM_EPISODE_DAYS=7
MEMORY_EPISODE_TTL_DAYS=90
MEMORY_RETRIEVAL_K=5
MEMORY_MAX_EPISODES=200
MEMORY_TOOLS_ENABLED=true
MEMORY_LLM_EXTRACTION=false
# AgentSession 只缓存能力相同的 Agent 图；JWT 按请求注入，不进入缓存。
AGENT_SESSION_TTL_SECONDS=1800
AGENT_SESSION_MAX_ENTRIES=128
AGENT_RUN_LEASE_TTL_SECONDS=180
