      "targets": [
        {
          "expr": "min(up{job=~\"backend|java-erp|prometheus|alertmanager\"})",
          "legendFormat": "service availability",
          "refId": "A"
        }
      ],
      "title": "Core Services Up",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "gridPos": {"h": 6, "w": 9, "x": 6, "y": 0},
      "id": 2,
      "targets": [
        {"expr": "sum(rate(http_requests_total[1m]))", "legendFormat": "backend", "refId": "A"},
        {"expr": "sum(rate(http_server_requests_seconds_count[1m]))", "legendFormat": "java-erp", "refId": "B"}
      ],
      "title": "HTTP Throughput",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 6, "w": 9, "x": 15, "y": 0},
      "id": 3,
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "backend p95", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le))", "legendFormat": "java-erp p95", "refId": "B"}
      ],
      "title": "HTTP Latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent"}},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 6},
      "id": 4,
      "targets": [
        {"expr": "100 * sum(rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 1)", "legendFormat": "backend", "refId": "A"},
        {"expr": "100 * sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count[5m])), 1)", "legendFormat": "java-erp", "refId": "B"}
      ],
      "title": "5xx Error Rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "gridPos": {"h": 7, "w": 8, "x": 8, "y": 6},
      "id": 5,
      "targets": [
        {"expr": "sum(increase(erp_write_reconcile_total[15m])) by (outcome)", "legendFormat": "{{outcome}}", "refId": "A"}
      ],
      "title": "ERP Write Reconciliation",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 6},
      "id": 6,
      "targets": [
        {"expr": "sum(ALERTS{alertstate=\"firing\"}) by (severity)", "legendFormat": "{{severity}}", "refId": "A"}
      ],
      "title": "Firing Alerts",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "gridPos": {"h": 7, "w": 8, "x": 0, "y": 13},
      "id": 7,
      "targets": [
        {"expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "heap used", "refId": "A"}
      ],
      "title": "Java ERP Heap",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "tempo", "uid": "tempo"},
      "fieldConfig": {"defaults": {}},
      "gridPos": {"h": 7, "w": 16, "x": 8, "y": 13},
      "id": 8,
      "targets": [
        {"limit": 20, "query": "{ resource.service.name =~ `erp-agent-.*` }", "queryType": "traceql", "refId": "A"}
      ],
      "title": "Backend → MCP → ERP Traces",
      "type": "traces"
    }
  ],
